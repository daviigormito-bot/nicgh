"""
Analise de eficiencia de alocacao - Baby Care LASA
Objetivo: medir quanto de sellout (MBRL) cada R$1 de pagamento gera
por subfamilia, e se essa relacao e confiavel.

Requisito: pip install pandas numpy openpyxl
"""

import pandas as pd
import numpy as np

# ----------------------------------------------------------------------
# 1) CONFIGURACAO - ajuste apenas estas linhas
# ----------------------------------------------------------------------
CAMINHO   = r"C:\caminho\para\sua\base.xlsx"   # caminho do arquivo Excel
ABA       = 0            # nome da aba (ex "Base") ou indice 0 = primeira aba
LINHA_CAB = 0            # linha do cabecalho (0 = primeira linha da planilha)

# Mapeamento: nome da coluna NA SUA PLANILHA -> nome usado no codigo.
# Ajuste o lado esquerdo para bater exatamente com os titulos da sua base.
COLUNAS = {
    'Sub Category':        'Sub Category',
    'Month (Real)':        'Month',
    'Sum of Sell Out MBRL':'MBRL',   # sellout em R$
    'Sum of TFI M':        'TFI',    # geracao - metodo 1
    'Sum of LR M':         'LR',     # geracao - metodo 2 (Love Rate)
    'PAGAMENTOS':          'PAG',    # pagamentos/investimento
}

# ----------------------------------------------------------------------
# 2) LEITURA E LIMPEZA
# ----------------------------------------------------------------------
df = pd.read_excel(CAMINHO, sheet_name=ABA, header=LINHA_CAB)
df = df.rename(columns=COLUNAS)[list(COLUNAS.values())]

# converte numeros: troca virgula decimal por ponto e forca tipo numerico
for c in ['MBRL', 'TFI', 'LR', 'PAG']:
    df[c] = (df[c].astype(str)
                  .str.replace('.', '', regex=False)   # remove separador de milhar
                  .str.replace(',', '.', regex=False)  # virgula decimal -> ponto
                  .replace({'nan': None, '': None}))
    df[c] = pd.to_numeric(df[c], errors='coerce')

# ----------------------------------------------------------------------
# 3) TABELA DE EFICIENCIA POR SUBFAMILIA
# ----------------------------------------------------------------------
linhas = []
for sub in df['Sub Category'].dropna().unique():
    s = df[df['Sub Category'] == sub].dropna(subset=['PAG', 'MBRL'])

    pag_tot     = s['PAG'].sum()
    ger_tot     = s['TFI'].sum() + s['LR'].sum()     # geracao = TFI + Love Rate
    sellout_tot = s['MBRL'].sum()

    # ROI medio (contabil): total de sellout dividido pelo total pago
    roi_medio = sellout_tot / pag_tot if pag_tot else np.nan

    # Eficiencia MARGINAL: inclinacao da reta MBRL = a + b*PAG
    #   b  = quanto o sellout sobe quando o pagamento sobe R$1
    #   R2 = quanto dessa relacao e explicada pelo pagamento (0 a 1)
    if len(s) >= 4 and s['PAG'].std() > 0:
        b, a = np.polyfit(s['PAG'], s['MBRL'], 1)
        r2   = np.corrcoef(s['PAG'], s['MBRL'])[0, 1] ** 2
    else:
        b, r2 = np.nan, np.nan

    linhas.append({
        'Subfamilia':           sub,
        'PAG_total':            round(pag_tot),
        'Geracao_TFI+LR':       round(ger_tot),
        'Pag_%_da_Geracao':     round(pag_tot / ger_tot * 100) if ger_tot else np.nan,
        'Sellout_total':        round(sellout_tot),
        'ROI_medio':            round(roi_medio, 1),
        'Sellout_por_R$1_pago': round(b, 2),
        'R2_confianca':         round(r2, 2),
    })

tabela = (pd.DataFrame(linhas)
            .sort_values('Sellout_por_R$1_pago', ascending=False))

print(tabela.to_string(index=False))

