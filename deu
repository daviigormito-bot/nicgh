def exportar_excel(
    caminho_saida,
    df_modelado,
    estado_atual,
    breakeven,
    parametros_otimizacao,
    alocacao,
    diagnostico,
    resumo_controle,
):

    print("\n")
    print("=" * 70)
    print("GERANDO EXCEL")
    print("=" * 70)

    with pd.ExcelWriter(
        caminho_saida,
        engine="openpyxl"
    ) as writer:

        df_modelado.to_excel(
            writer,
            sheet_name="Base_Modelada",
            index=False
        )

        estado_atual.to_excel(
            writer,
            sheet_name="Estado_Atual",
            index=False
        )

        breakeven.to_excel(
            writer,
            sheet_name="BreakEven",
            index=False
        )

        parametros_otimizacao.to_excel(
            writer,
            sheet_name="Parametros_Otimizacao",
            index=False
        )

        if not alocacao.empty:

            alocacao.to_excel(
                writer,
                sheet_name="Alocacao_Otima",
                index=False
            )

        diagnostico.to_excel(
            writer,
            sheet_name="Diagnostico",
            index=False
        )

        resumo_controle.to_excel(
            writer,
            sheet_name="Controle_Modelo",
            index=False
        )

    formatar_excel(
        caminho_saida,
        None
    )

    print(
        f"\nArquivo gerado com sucesso:"
    )

    print(
        Path(
            caminho_saida
        ).resolve()
    )


