def preparar_base(df):

    mapa = padronizar_colunas(df)

    novo = pd.DataFrame()

    novo["mes"] = df[mapa["mes"]]
    novo["mg5"] = df[mapa["mg5"]]
    novo["data"] = pd.to_datetime(
        df[mapa["data"]],
        errors="coerce"
    )

    novo["subcategoria_original"] = (
        df[mapa["subcategoria"]]
    )

    novo["subcategoria"] = (
        df[mapa["subcategoria"]]
        .apply(normalizar_subcategoria)
    )

    colunas_numericas = {
        "sell_out_unid": "sell_out_unid",
        "sell_out_rs": "sell_out_rs",
        "pagamento_so": "pagamento_so",
        "incremental_unid_so": "incremental_unid_so",
        "incremental_rs_so": "incremental_rs_so",
        "sell_in_qtd_it": "sell_in_qtd_it",
        "sell_in_rs": "sell_in_rs",
        "pagamento_si": "pagamento_si",
    }

    if mapa["incremental_rs_si"] is not None:
        colunas_numericas[
            "incremental_rs_si"
        ] = "incremental_rs_si"

    if mapa["incremental_qtd_it_si"] is not None:
        colunas_numericas[
            "incremental_qtd_it_si"
        ] = "incremental_qtd_it_si"

    for destino, origem in colunas_numericas.items():

        col_original = mapa[
            origem
        ]

        novo[destino] = (
            df[col_original]
            .apply(converter_numero_br)
        )

    # Caso não exista coluna explícita de incremental SI
    if "incremental_rs_si" not in novo.columns:

        novo["incremental_rs_si"] = 0.0

    if "incremental_qtd_it_si" not in novo.columns:

        novo["incremental_qtd_it_si"] = 0.0

    # MG5 como texto
    novo["mg5"] = (
        novo["mg5"]
        .fillna("")
        .astype(str)
        .str.strip()
    )

    # Ordenação
    novo = novo.sort_values(
        [
            "subcategoria",
            "mg5",
            "data"
        ]
    ).reset_index(drop=True)

    return novo


