def limpar_texto(valor):
    """
    Converte texto para uma forma padronizada.
    """
    if pd.isna(valor):
        return ""

    valor = str(valor).strip().upper()

    return valor


def normalizar_subcategoria(valor):
    """
    Converte os nomes presentes no Excel para os nomes
    usados no modelo.
    """

    valor = limpar_texto(valor)

    mapa = {
        "BABY CARE - SUPERSEC": "SUPERSEC",
        "SUPERSEC": "SUPERSEC",

        "BABY WIPES": "BABY WIPES",

        "NEW BABY": "NEWBABY",
        "NEWBABY": "NEWBABY",

        "CONFORT SEC": "CONFORTSEC",
        "CONFORTSEC": "CONFORTSEC",

        "PANTS AT": "PANTS AT",

        "PREMIUM CARE": "PREMIUM CARE",
    }

    return mapa.get(valor, valor)


def converter_numero_br(valor):
    """
    Converte números brasileiros:

        1.234,56
        R$ 1.234,56
        -R$ 1.234,56
        R$ -
        -

    para float.
    """

    if pd.isna(valor):
        return 0.0

    if isinstance(valor, (int, float, np.integer, np.floating)):
        return float(valor)

    texto = str(valor).strip()

    if texto == "":
        return 0.0

    texto_upper = texto.upper()

    if texto_upper in {
        "-",
        "R$ -",
        "R$-",
        "N/A",
        "NA",
        "NULL",
        "NONE",
    }:
        return 0.0

    negativo = False

    if texto.startswith("-"):
        negativo = True
        texto = texto[1:].strip()

    if texto.endswith("-"):
        negativo = True
        texto = texto[:-1].strip()

    texto = (
        texto
        .replace("R$", "")
        .replace(" ", "")
    )

    # Formato brasileiro:
    # 1.234.567,89
    if "," in texto:
        texto = texto.replace(".", "")
        texto = texto.replace(",", ".")

    # Formato sem vírgula:
    # 1234567
    try:
        numero = float(texto)
    except ValueError:
        return np.nan

    if negativo:
        numero *= -1

    return numero


def dividir_seguro(a, b):
    """
    Divisão protegida contra zero.
    """

    if isinstance(a, pd.Series):
        a = a.astype(float)

    if isinstance(b, pd.Series):
        b = b.astype(float)

    with np.errstate(divide="ignore", invalid="ignore"):
        resultado = a / b

    if isinstance(resultado, pd.Series):
        resultado = resultado.replace(
            [np.inf, -np.inf],
            np.nan
        )

    elif np.isscalar(resultado):
        if not np.isfinite(resultado):
            return np.nan

    return resultado


