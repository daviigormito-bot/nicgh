def calcular_alfa(df, janela=6):

    """
    Calcula o fator:

        alfa =
        preço líquido SI / preço SO

    utilizando média móvel por subcategoria/MG5.

    Depois consolida por subcategoria usando o baseline
    como peso.

    """

    dados = df.copy()

    dados["preco_si"] = dividir_seguro(
        dados["sell_in_rs"],
        dados["si_eq"]
    )

    dados["preco_so"] = dividir_seguro(
        dados["sell_out_rs"],
        dados["sell_out_unid"]
    )

    dados["alfa_mg5"] = dividir_seguro(
        dados["preco_si"],
        dados["preco_so"]
    )

    dados = dados.sort_values(
        [
            "subcategoria",
            "mg5",
            "data"
        ]
    )

    grupos = (
        dados
        .groupby(
            [
                "subcategoria",
                "mg5"
            ],
            group_keys=False
        )
    )

    dados["si_rs_movel"] = (
        grupos["sell_in_rs"]
        .transform(
            lambda s:
            s.rolling(
                janela,
                min_periods=1
            ).sum()
        )
    )

    dados["si_eq_movel"] = (
        grupos["si_eq"]
        .transform(
            lambda s:
            s.rolling(
                janela,
                min_periods=1
            ).sum()
        )
    )

    dados["so_rs_movel"] = (
        grupos["sell_out_rs"]
        .transform(
            lambda s:
            s.rolling(
                janela,
                min_periods=1
            ).sum()
        )
    )

    dados["so_unid_movel"] = (
        grupos["sell_out_unid"]
        .transform(
            lambda s:
            s.rolling(
                janela,
                min_periods=1
            ).sum()
        )
    )

    dados["preco_si_movel"] = dividir_seguro(
        dados["si_rs_movel"],
        dados["si_eq_movel"]
    )

    dados["preco_so_movel"] = dividir_seguro(
        dados["so_rs_movel"],
        dados["so_unid_movel"]
    )

    dados["alfa_movel"] = dividir_seguro(
        dados["preco_si_movel"],
        dados["preco_so_movel"]
    )

    # Último alfa disponível por MG5
    ultimo = (
        dados
        .sort_values("data")
        .groupby(
            [
                "subcategoria",
                "mg5"
            ],
            as_index=False
        )
        .tail(1)
    )

    # Consolidação por subcategoria
    ultimo["peso"] = (
        ultimo["baseline_rs"]
        .clip(lower=0)
    )

    def alfa_ponderado(grupo):

        pesos = grupo["peso"].to_numpy(
            dtype=float
        )

        valores = grupo["alfa_movel"].to_numpy(
            dtype=float
        )

        mascara = (
            np.isfinite(valores)
            & np.isfinite(pesos)
            & (pesos > 0)
        )

        if mascara.sum() == 0:

            valores_validos = valores[
                np.isfinite(valores)
            ]

            if len(valores_validos) == 0:
                return np.nan

            return np.median(
                valores_validos
            )

        return np.average(
            valores[mascara],
            weights=pesos[mascara]
        )

    alfa_subcategoria = (
        ultimo
        .groupby("subcategoria")
        .apply(alfa_ponderado)
        .rename("alfa")
        .reset_index()
    )

    return dados, alfa_subcategoria


