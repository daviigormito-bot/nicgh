def encontrar_coluna(df, candidatos, obrigatoria=True):

    colunas = list(df.columns)

    mapa = {
        str(c).strip().lower(): c
        for c in colunas
    }

    for candidato in candidatos:

        chave = candidato.strip().lower()

        if chave in mapa:
            return mapa[chave]

    # Busca aproximada
    for candidato in candidatos:

        candidato_lower = candidato.strip().lower()

        for coluna in colunas:

            coluna_lower = str(coluna).strip().lower()

            if candidato_lower in coluna_lower:
                return coluna

    if obrigatoria:
        raise KeyError(
            "\nNão foi possível encontrar uma coluna obrigatória.\n"
            f"Candidatos procurados: {candidatos}\n"
            f"Colunas disponíveis:\n{colunas}"
        )

    return None


def padronizar_colunas(df):

    print("\nPadronizando colunas...")

    mapeamento = {}

    mapeamento["mes"] = encontrar_coluna(
        df,
        ["Mês"]
    )

    mapeamento["mg5"] = encontrar_coluna(
        df,
        ["MG5"]
    )

    mapeamento["data"] = encontrar_coluna(
        df,
        ["data"]
    )

    mapeamento["subcategoria"] = encontrar_coluna(
        df,
        ["Subcategoria"]
    )

    mapeamento["sell_out_unid"] = encontrar_coluna(
        df,
        ["Sell-out unid. mês"]
    )

    mapeamento["sell_out_rs"] = encontrar_coluna(
        df,
        ["Sell-out R$ mês"]
    )

    mapeamento["pagamento_so"] = encontrar_coluna(
        df,
        ["Pagamento do mês (R$)"]
    )

    mapeamento["incremental_unid_so"] = encontrar_coluna(
        df,
        ["Incremental unid. (baseline ex-Nov)"]
    )

    mapeamento["incremental_rs_so"] = encontrar_coluna(
        df,
        ["Incremental R$ (baseline ex-Nov)"],
        obrigatoria=True
    )

    mapeamento["sell_in_qtd_it"] = encontrar_coluna(
        df,
        ["Sell-in Qtd IT mês"]
    )

    mapeamento["sell_in_rs"] = encontrar_coluna(
        df,
        ["Sell-in R$ mês"]
    )

    mapeamento["pagamento_si"] = encontrar_coluna(
        df,
        ["Pagamento sell-in alocado (R$)"]
    )

    # A planilha possui o segundo "Incremental R$ (baseline ex-Nov)"
    # referente ao Sell-In. O Pandas normalmente transforma o segundo
    # cabeçalho em "... .1".
    mapeamento["incremental_rs_si"] = encontrar_coluna(
        df,
        [
            "Incremental R$ (baseline ex-Nov).1",
            "Incremental R$ (baseline ex-Nov)",
        ],
        obrigatoria=False
    )

    # Incremental Qtd IT do sell-in
    mapeamento["incremental_qtd_it_si"] = encontrar_coluna(
        df,
        ["Incremental Qtd IT (baseline ex-Nov)"],
        obrigatoria=False
    )

    return mapeamento


