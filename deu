# 22. RESUMO EXECUTIVO NO TERMINAL
# ============================================================

def imprimir_resumo(
    df_modelado,
    estado_atual,
    alocacao,
    lucro_total,
    controle
):

    print("\n")
    print("=" * 70)
    print("RESUMO EXECUTIVO DO MODELO")
    print("=" * 70)

    print(
        f"\nPeríodo inicial: "
        f"{df_modelado['data'].min().date()}"
    )

    print(
        f"Período final:   "
        f"{df_modelado['data'].max().date()}"
    )

    print(
        f"\nSubcategorias:"
    )

    for sub in sorted(
        df_modelado["subcategoria"]
        .dropna()
        .unique()
    ):

        print(
            f"  - {sub}"
        )

    print(
        f"\nLambda estoque: "
        f"{controle['lambda']:.6f}"
    )

    print(
        f"Kappa: "
        f"{controle['kappa']:.6f}"
    )

    print(
        f"Método Kappa: "
        f"{controle['motivo_kappa']}"
    )

    print(
        "\nMROI atual por subcategoria:"
    )

    colunas = [
        "subcategoria",
        "mroi",
        "roi_so",
        "roi_breakeven",
        "r_estoque",
        "alfa",
        "f_estoque",
        "f_saturacao",
    ]

    resumo = (
        estado_atual[
            colunas
        ]
        .sort_values(
            "mroi",
            ascending=False
        )
    )

    for _, linha in resumo.iterrows():

        print(
            f"\n{linha['subcategoria']}"
        )

        print(
            f"  MROI:              "
            f"{linha['mroi']:.4f}"
        )

        print(
            f"  ROI Sell-Out:      "
            f"{linha['roi_so']:.4f}"
            if np.isfinite(
                linha["roi_so"]
            )
            else
            "  ROI Sell-Out:      N/A"
        )

        print(
            f"  ROI Break-even:    "
            f"{linha['roi_breakeven']:.4f}"
            if np.isfinite(
                linha["roi_breakeven"]
            )
            else
            "  ROI Break-even:    N/A"
        )

        print(
            f"  SI/SO:             "
            f"{linha['r_estoque']:.4f}"
        )

        print(
            f"  Alfa:              "
            f"{linha['alfa']:.4f}"
            if np.isfinite(
                linha["alfa"]
            )
            else
            "  Alfa:              N/A"
        )

        print(
            f"  Fator estoque:     "
            f"{linha['f_estoque']:.4f}"
        )

        print(
            f"  Fator saturação:   "
            f"{linha['f_saturacao']:.4f}"
        )

    if not alocacao.empty:

        print("\n")
        print(
            "=" * 70
        )

        print(
            "ALOCACAO OTIMA"
        )

        print(
            "=" * 70
        )

        for _, linha in alocacao.iterrows():

            print(
                f"\n{linha['subcategoria']}"
            )

            print(
                f"  Verba ótima:       "
                f"R$ {linha['verba_otima']:,.2f}"
            )

            print(
                f"  Lucro incremental: "
                f"R$ {linha['lucro_incremental']:,.2f}"
            )

            print(
                f"  MROI alocado:      "
                f"{linha['mroi_alocacao']:.4f}"
            )

        print(
            f"\nLucro incremental total: "
            f"R$ {lucro_total:,.2f}"
        )


