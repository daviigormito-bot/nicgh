# 23. EXECUÇÃO PRINCIPAL
# ============================================================

def main():

    print("\n")
    print("=" * 70)
    print(
        "MODELO DE MROI - FMCG"
    )
    print("=" * 70)

    # --------------------------------------------------------
    # Passo 1 - Ler Excel
    # --------------------------------------------------------

    df_raw = ler_excel(
        ARQUIVO_BASE,
        ABA_EXCEL
    )

    # --------------------------------------------------------
    # Passo 2 - Padronizar
    # --------------------------------------------------------

    df = preparar_base(
        df_raw
    )

    print(
        f"\nLinhas após preparação: "
        f"{len(df):,}"
    )

    # --------------------------------------------------------
    # Passo 3 - Fator IT
    # --------------------------------------------------------

    df = adicionar_fator_it_unidade(
        df
    )

    # --------------------------------------------------------
    # Passo 4 - Variáveis básicas
    # --------------------------------------------------------

    df = calcular_variaveis_basicas(
        df
    )

    # --------------------------------------------------------
    # Passo 5 - Alfa
    # --------------------------------------------------------

    print(
        "\nCalculando alfa..."
    )

    _, alfa_subcategoria = (
        calcular_alfa(
            df,
            janela=JANELA_ALFA
        )
    )

    # --------------------------------------------------------
    # Passo 6 - SI/SO
    # --------------------------------------------------------

    print(
        "Calculando SI/SO..."
    )

    r_estoque = calcular_r_estoque(
        df,
        H=JANELA_ESTOQUE
    )

    # --------------------------------------------------------
    # Passo 7 - Parâmetros do modelo
    # --------------------------------------------------------

    print(
        "Montando fatores econômicos..."
    )

    df, controle = montar_parametros(
        df,
        alfa_subcategoria,
        r_estoque,
        metodo_kappa=METODO_KAPPA
    )

    # --------------------------------------------------------
    # Passo 8 - Estado atual
    # --------------------------------------------------------

    estado_atual = criar_estado_atual(
        df
    )

    # --------------------------------------------------------
    # Passo 9 - Break-even
    # --------------------------------------------------------

    breakeven = calcular_breakeven_atual(
        df
    )

    # --------------------------------------------------------
    # Passo 10 - Parâmetros para otimização
    # --------------------------------------------------------

    parametros_otimizacao = (
        montar_pool_otimizacao(
            df
        )
    )

    # --------------------------------------------------------
    # Passo 11 - Otimização
    # --------------------------------------------------------

    alocacao = pd.DataFrame()
    lucro_total = 0.0

    if ORCAMENTO_TOTAL > 0:

        print(
            "\nOtimizando orçamento..."
        )

        alocacao, lucro_total = (
            otimizar_verba(
                parametros_otimizacao,
                ORCAMENTO_TOTAL,
                OBRIGAR_GASTAR_TODO_ORCAMENTO
            )
        )

    else:

        print(
            "\nORCAMENTO_TOTAL = 0."
        )

        print(
            "Apenas análise do MROI será executada."
        )

    # --------------------------------------------------------
    # Passo 12 - Diagnóstico
    # --------------------------------------------------------

    diagnostico, resumo_controle = (
        criar_diagnostico(
            df,
            controle
        )
    )

    # --------------------------------------------------------
    # Passo 13 - Exportar
    # --------------------------------------------------------

    exportar_excel(
        ARQUIVO_SAIDA,
        df,
        estado_atual,
        breakeven,
        parametros_otimizacao,
        alocacao,
        diagnostico,
        resumo_controle,
    )

    # --------------------------------------------------------
    # Passo 14 - Resumo
    # --------------------------------------------------------

    imprimir_resumo(
        df,
        estado_atual,
        alocacao,
        lucro_total,
        controle
    )

    print("\n")
    print("=" * 70)
    print(
        "PROCESSAMENTO CONCLUIDO"
    )
    print("=" * 70)


# ============================================================
# 24. EXECUTA
# ============================================================

if __name__ == "__main__":

    main()
