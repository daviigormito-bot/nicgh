# ============================================================
# 16. PARÂMETROS PARA OTIMIZAÇÃO
# ============================================================

def montar_pool_otimizacao(
    df
):

    # Último mês com dados disponíveis
    ultima_data = df["data"].max()

    atual = (
        df[
            df["data"] == ultima_data
        ]
        .groupby("subcategoria")
        .agg(
            m=("m", "first"),
            alfa=("alfa", "first"),
            r=("r_estoque", "first"),
            f_estoque=("f_estoque", "first"),
            eps=("elasticidade", "first"),
            kappa=("kappa", "first"),
            baseline=("baseline_rs", "sum"),
            pagamento=("pagamento_so", "sum"),
            incremental=("incremental_rs_so", "sum"),
            roi_so=("roi_so", "mean"),
            eta=("eta", "first"),
        )
        .reset_index()
    )

    # -----------------------------------------------
    # Intensity: k = kappa * eps / baseline
    # -----------------------------------------------

    atual["k"] = dividir_seguro(
        atual["kappa"]
        * atual["eps"],
        atual["baseline"]
    )

    # -----------------------------------------------
    # Assíntota da curva
    # -----------------------------------------------
    #
    # incremental =
    # A * [1-exp(-k*B)]
    #
    # A =
    # incremental /
    # [1-exp(-k*pagamento)]
    #

    denominador = (
        1
        -
        np.exp(
            -atual["k"]
            * atual["pagamento"]
        )
    )

    atual["A"] = dividir_seguro(
        atual["incremental"],
        denominador
    )

    # -----------------------------------------------
    # Filtro de elegibilidade
    # -----------------------------------------------

    atual["elegivel_otimizacao"] = (
        (atual["pagamento"] > 0)
        &
        (atual["baseline"] > 0)
        &
        (atual["incremental"] > 0)
        &
        np.isfinite(atual["k"])
        &
        (atual["k"] > 0)
        &
        np.isfinite(atual["A"])
        &
        (atual["A"] > 0)
    )

    return atual


# ============================================================
# 17. FUNÇÃO DE OTIMIZAÇÃO
# ============================================================

def otimizar_verba(
    params,
    pool,
    obrigar_gastar=False
):

    dados = params.copy()

    dados = dados[
        dados["elegivel_otimizacao"]
    ].copy()

    if dados.empty:

        print(
            "\nNenhuma subcategoria possui "
            "dados elegíveis para otimização."
        )

        return (
            pd.DataFrame(),
            0.0
        )

    nomes = (
        dados["subcategoria"]
        .tolist()
    )

    k = dados["k"].to_numpy(
        dtype=float
    )

    A = dados["A"].to_numpy(
        dtype=float
    )

    fator_lucro = (
        dados["m"]
        *
        dados["alfa"]
        *
        dados["f_estoque"]
    ).to_numpy(
        dtype=float
    )

    eta = dados["eta"].to_numpy(
        dtype=float
    )

    if pool <= 0:

        return (
            pd.DataFrame(),
            0.0
        )

    # --------------------------------------------------------
    # Limites
    # --------------------------------------------------------

    # Para evitar uma concentração irreal,
    # cada subcategoria pode receber até 50%
    # do pool.
    #
    # Isso é apenas um default de proteção.
    #
    limite_maximo = pool * 0.50

    limites = [
        (
            0.0,
            limite_maximo
        )
        for _ in nomes
    ]

    # --------------------------------------------------------
    # Lucro
    # --------------------------------------------------------

    def lucro(B):

        incremental_modelado = (
            A
            *
            (
                1
                -
                np.exp(
                    -k * B
                )
            )
        )

        receita_lucro = (
            fator_lucro
            *
            incremental_modelado
        )

        custo_verba = (
            (1 + eta)
            *
            B
        )

        return np.sum(
            receita_lucro
            -
            custo_verba
        )

    def objetivo(B):
        return -lucro(B)

    # --------------------------------------------------------
    # Chute inicial
    # --------------------------------------------------------

    n = len(nomes)

    B0 = np.full(
        n,
        pool / n
    )

    B0 = np.minimum(
        B0,
        limite_maximo
    )

    # Ajusta o chute para que a soma fique igual ao pool
    if B0.sum() < pool:

        B0 = np.full(
            n,
            limite_maximo
        )

        diferenca = (
            pool
            -
            B0.sum()
        )

        if diferenca > 0:
            # libera a restrição simplesmente
            # usando distribuição igual
            B0 = np.full(
                n,
                pool / n
            )

    # --------------------------------------------------------
    # Restrição
    # --------------------------------------------------------

    if obrigar_gastar:

        restricoes = [
            {
                "type": "eq",
                "fun": lambda B:
                np.sum(B) - pool
            }
        ]

    else:

        # Caso não seja obrigatório gastar,
        # acrescentamos a opção de "não gastar".
        #
        # Para SLSQP, usamos <= pool.
        restricoes = [
            {
                "type": "ineq",
                "fun": lambda B:
                pool - np.sum(B)
            }
        ]

    # --------------------------------------------------------
    # Otimização
    # --------------------------------------------------------

    res = minimize(
        objetivo,
        B0,
        bounds=limites,
        constraints=restricoes,
        method="SLSQP",
        options={
            "maxiter": 2000,
            "ftol": 1e-8,
            "disp": False,
        }
    )

    if not res.success:

        print(
            "\nAVISO:"
        )

        print(
            "O otimizador não convergiu perfeitamente."
        )

        print(
            f"Mensagem: {res.message}"
        )

    B = np.maximum(
        res.x,
        0
    )

    # --------------------------------------------------------
    # Resultado
    # --------------------------------------------------------

    resultado = dados[
        [
            "subcategoria",
            "m",
            "alfa",
            "r",
            "f_estoque",
            "eps",
            "kappa",
            "baseline",
            "pagamento",
            "incremental",
            "roi_so",
            "elegivel_otimizacao",
        ]
    ].copy()

    resultado["verba_otima"] = B

    resultado["incremental_modelado"] = (
        resultado["A"].to_numpy()
        *
        (
            1
            -
            np.exp(
                -resultado["k"].to_numpy()
                * B
            )
        )
        if "A" in resultado.columns
        else 0
    )

    resultado["receita_lucro_modelado"] = (
        resultado["m"]
        *
        resultado["alfa"]
        *
        resultado["f_estoque"]
        *
        resultado["incremental_modelado"]
    )

    resultado["custo_verba"] = (
        (1 + ETA_PADRAO)
        *
        resultado["verba_otima"]
    )

    resultado["lucro_incremental"] = (
        resultado["receita_lucro_modelado"]
        -
        resultado["custo_verba"]
    )

    resultado["mroi_alocacao"] = dividir_seguro(
        resultado["lucro_incremental"],
        resultado["verba_otima"]
    )

    resultado["participacao_verba"] = dividir_seguro(
        resultado["verba_otima"],
        resultado["verba_otima"].sum()
    )

    resultado = resultado.sort_values(
        "verba_otima",
        ascending=False
    )

    lucro_total = (
        resultado["lucro_incremental"]
        .sum()
    )

    return resultado, float(
        lucro_total
    )


# ============================================================
# 18. BREAK-EVEN
# ============================================================

def calcular_breakeven_atual(
    df
):

    estado = criar_estado_atual(
        df
    )

    estado["roi_so_breakeven"] = (
        estado["roi_breakeven"]
    )

    estado["ganho_vs_breakeven"] = (
        estado["roi_so"]
        -
        estado["roi_so_breakeven"]
    )

    estado["acima_do_breakeven"] = (
        estado["roi_so"]
        >=
        estado["roi_so_breakeven"]
    )

    return estado


# ============================================================
# 19. DIAGNÓSTICO
# ============================================================

def criar_diagnostico(
    df,
    controle
):

    problemas = []

    for _, linha in df.iterrows():

        sub = linha["subcategoria"]

        if sub not in MARGENS:

            problemas.append(
                {
                    "tipo": "Margem",
                    "subcategoria": sub,
                    "data": linha["data"],
                    "problema": (
                        "Subcategoria sem margem configurada."
                    ),
                }
            )

        if sub not in ELASTICIDADES:

            problemas.append(
                {
                    "tipo": "Elasticidade",
                    "subcategoria": sub,
                    "data": linha["data"],
                    "problema": (
                        "Subcategoria sem elasticidade configurada."
                    ),
                }
            )

        if linha["baseline_rs"] <= 0:

            problemas.append(
                {
                    "tipo": "Baseline",
                    "subcategoria": sub,
                    "data": linha["data"],
                    "problema": (
                        "Baseline Sell-Out menor ou igual a zero."
                    ),
                }
            )

        if (
            linha["pagamento_so"] > 0
            and not np.isfinite(
                linha["roi_so"]
            )
        ):

            problemas.append(
                {
                    "tipo": "ROI",
                    "subcategoria": sub,
                    "data": linha["data"],
                    "problema": (
                        "Pagamento positivo, mas ROI "
                        "não pôde ser calculado."
                    ),
                }
            )

        if linha["flag_r_neutro"]:

            problemas.append(
                {
                    "tipo": "Estoque",
                    "subcategoria": sub,
                    "data": linha["data"],
                    "problema": (
                        "SI/SO inicializado em 1 por falta "
                        "de histórico suficiente."
                    ),
                }
            )

    diagnostico = pd.DataFrame(
        problemas
    )

    if diagnostico.empty:

        diagnostico = pd.DataFrame(
            {
                "tipo": ["OK"],
                "subcategoria": [""],
                "data": [""],
                "problema": [
                    "Nenhum problema estrutural encontrado."
                ],
            }
        )

    # Adiciona controle
    resumo = pd.DataFrame(
        {
            "parametro": [
                "Lambda",
                "Kappa",
                "Metodo Kappa",
                "Janela Estoque",
                "Janela Alfa",
                "r_star",
                "f_estoque_star",
                "carga_promocional_star",
                "f_saturacao_star",
            ],
            "valor": [
                controle["lambda"],
                controle["kappa"],
                controle["motivo_kappa"],
                JANELA_ESTOQUE,
                JANELA_ALFA,
                R_ESTOQUE_STAR,
                F_ESTOQUE_STAR,
                CARGA_PROMOCIONAL_STAR,
                F_SATURACAO_STAR,
            ],
        }
    )

    return diagnostico, resumo


# ============================================================
# 20. FORMATAÇÃO DO EXCEL
# ============================================================

def formatar_excel(
    caminho,
    abas
):

    from openpyxl import load_workbook
    from openpyxl.styles import (
        Font,
        PatternFill,
        Alignment,
        Border,
        Side,
    )
    from openpyxl.utils import get_column_letter

    wb = load_workbook(
        caminho
    )

    # Cores
    azul_escuro = "17365D"
    azul_claro = "D9EAF7"
    cinza = "D9E1F2"
    vermelho_claro = "F4CCCC"
    verde_claro = "D9EAD3"
    amarelo = "FFF2CC"

    branco = "FFFFFF"
    preto = "000000"

    borda = Side(
        style="thin",
        color="B7B7B7"
    )

    for nome_aba in wb.sheetnames:

        ws = wb[nome_aba]

        ws.sheet_view.showGridLines = False

        # Cabeçalho
        for cell in ws[1]:

            cell.fill = PatternFill(
                "solid",
                fgColor=azul_escuro
            )

            cell.font = Font(
                color=branco,
                bold=True
            )

            cell.alignment = Alignment(
                horizontal="center",
                vertical="center"
            )

            cell.border = Border(
                bottom=borda
            )

        # Autofiltro
        ws.auto_filter.ref = ws.dimensions

        # Congelar cabeçalho
        ws.freeze_panes = "A2"

        # Largura
        for col_idx, coluna in enumerate(
            ws.columns,
            start=1
        ):

            valores = []

            for cell in coluna:

                if cell.value is not None:
                    valores.append(
                        str(cell.value)
                    )

            if valores:

                largura = min(
                    max(
                        len(x)
                        for x in valores
                    ) + 2,
                    35
                )

                ws.column_dimensions[
                    get_column_letter(
                        col_idx
                    )
                ].width = largura

        # Formatação de números
        cabecalhos = [
            cell.value
            for cell in ws[1]
        ]

        for idx, cab in enumerate(
            cabecalhos,
            start=1
        ):

            if cab is None:
                continue

            cab_str = str(
                cab
            ).lower()

            for row in range(
                2,
                ws.max_row + 1
            ):

                cell = ws.cell(
                    row=row,
                    column=idx
                )

                # Valores monetários
                if (
                    "r$" in cab_str
                    or
                    "verba" in cab_str
                    or
                    "lucro" in cab_str
                    or
                    "receita" in cab_str
                    or
                    "pagamento" in cab_str
                    or
                    "incremental" in cab_str
                    and "$" in cab_str
                ):

                    cell.number_format = (
                        'R$ #,##0.00;'
                        '[Red](R$ #,##0.00);-'
                    )

                # Percentuais
                elif (
                    "%" in cab_str
                    or
                    cab_str.startswith("mroi")
                    or
                    "margem" in cab_str
                    or
                    "participacao" in cab_str
                ):

                    cell.number_format = (
                        '0.0%;'
                        '[Red](0.0%);-'
                    )

                # Múltiplos
                elif (
                    "roi_so" in cab_str
                    or
                    "roi_breakeven" in cab_str
                ):

                    cell.number_format = (
                        '0.00x;'
                        '[Red](0.00x);-'
                    )

                # Números
                else:

                    if isinstance(
                        cell.value,
                        (int, float)
                    ):

                        cell.number_format = (
                            '#,##0.00;'
                            '[Red](#,##0.00);-'
                        )

        # Coloração especial para status
        for row in ws.iter_rows(
            min_row=2
        ):

            for cell in row:

                valor = (
                    str(cell.value)
                    .strip()
                    .lower()
                )

                if valor in {
                    "excelente",
                    "positivo"
                }:

                    cell.fill = PatternFill(
                        "solid",
                        fgColor=verde_claro
                    )

                elif valor == "negativo":

                    cell.fill = PatternFill(
                        "solid",
                        fgColor=vermelho_claro
                    )

                elif (
                    "sem promoção"
                    in valor
                ):

                    cell.fill = PatternFill(
                        "solid",
                        fgColor=cinza
                    )

    wb.save(
        caminho
    )


