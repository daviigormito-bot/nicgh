# ============================================================
# 8. BASELINE E INTENSIDADE PROMOCIONAL
# ============================================================

def calcular_variaveis_basicas(df):

    # Baseline financeiro de Sell-Out
    df["baseline_rs"] = (
        df["sell_out_rs"]
        - df["incremental_rs_so"]
    )

    # Impede baseline negativo para cálculo da intensidade.
    df["baseline_rs_calculo"] = (
        df["baseline_rs"]
        .where(df["baseline_rs"] > 0)
    )

    # Intensidade promocional
    df["z"] = dividir_seguro(
        df["pagamento_so"],
        df["baseline_rs_calculo"]
    )

    # Preço médio do Sell-Out
    df["preco_so"] = dividir_seguro(
        df["sell_out_rs"],
        df["sell_out_unid"]
    )

    # Preço médio do Sell-In
    df["preco_si"] = dividir_seguro(
        df["sell_in_rs"],
        df["si_eq"]
    )

    # ROI médio observado do Sell-Out
    df["roi_so"] = dividir_seguro(
        df["incremental_rs_so"],
        df["pagamento_so"]
    )

    # Quando não houve verba, ROI não existe
    df.loc[
        df["pagamento_so"] <= 0,
        "roi_so"
    ] = np.nan

    return df


