# 10. SI/SO
# ============================================================

def calcular_r_estoque(df, H=3):

    dados = df.copy()

    dados = dados.sort_values(
        [
            "subcategoria",
            "data"
        ]
    )

    # Como existem vários MG5 dentro da subcategoria,
    # primeiro agregamos fisicamente a subcategoria por mês.

    mensal = (
        dados
        .groupby(
            [
                "subcategoria",
                "data"
            ],
            as_index=False
        )
        .agg(
            si_eq=("si_eq", "sum"),
            sell_out_unid=("sell_out_unid", "sum"),
        )
    )

    mensal = mensal.sort_values(
        [
            "subcategoria",
            "data"
        ]
    )

    grupo = (
        mensal
        .groupby("subcategoria")
    )

    # Defasagem de um mês.
    mensal["si_eq_lag"] = (
        grupo["si_eq"]
        .shift(1)
    )

    mensal["so_unid_lag"] = (
        grupo["sell_out_unid"]
        .shift(1)
    )

    grupo_lag = (
        mensal
        .groupby("subcategoria")
    )

    mensal["si_rolling"] = (
        grupo_lag["si_eq_lag"]
        .transform(
            lambda s:
            s.rolling(
                H,
                min_periods=H
            ).sum()
        )
    )

    mensal["so_rolling"] = (
        grupo_lag["so_unid_lag"]
        .transform(
            lambda s:
            s.rolling(
                H,
                min_periods=H
            ).sum()
        )
    )

    mensal["r_estoque"] = dividir_seguro(
        mensal["si_rolling"],
        mensal["so_rolling"]
    )

    # Nos primeiros meses, ainda não há 3 meses históricos.
    # Utilizamos r=1 como neutro e criamos uma flag.
    mensal["flag_r_neutro"] = (
        mensal["r_estoque"].isna()
    )

    mensal["r_estoque"] = (
        mensal["r_estoque"]
        .replace(
            [np.inf, -np.inf],
            np.nan
        )
        .fillna(1.0)
    )

    return mensal


# ============================================================
# 11. FATOR DE ESTOQUE
# ============================================================

def lambda_por_calibracao(
    r_star=1.5,
    f_star=0.60
):

    if r_star <= 0:
        raise ValueError(
            "r_star deve ser > 0."
        )

    if r_star == 1:
        raise ValueError(
            "r_star não pode ser 1."
        )

    if not (0 < f_star <= 1):
        raise ValueError(
            "f_star deve estar entre 0 e 1."
        )

    return (
        -np.log(f_star)
        /
        (np.log(r_star) ** 2)
    )


def f_estoque(r, lam):

    r = np.asarray(
        r,
        dtype=float
    )

    r = np.where(
        r > 0,
        r,
        np.nan
    )

    return np.exp(
        -lam * np.log(r) ** 2
    )


# ============================================================
# 12. FATOR DE SATURAÇÃO
# ============================================================

def f_saturacao(x):

    x = np.asarray(
        x,
        dtype=float
    )

    resultado = np.ones_like(
        x,
        dtype=float
    )

    mascara = x > 1e-9

    resultado[mascara] = (
        x[mascara]
        /
        np.expm1(x[mascara])
    )

    return resultado


def estimar_kappa_calibrado(
    carga_star=1.0,
    fator_star=0.70
):

    """
    Resolve aproximadamente:

        x / (e^x - 1) = fator_star

    quando:

        elasticidade × intensidade = carga_star

    """

    if carga_star <= 0:
        raise ValueError(
            "carga_star deve ser > 0."
        )

    if not (0 < fator_star < 1):
        raise ValueError(
            "fator_star deve estar entre 0 e 1."
        )

    # Busca numérica simples
    x_grid = np.linspace(
        1e-6,
        20,
        200000
    )

    valores = f_saturacao(
        x_grid
    )

    idx = np.argmin(
        np.abs(
            valores - fator_star
        )
    )

    x = x_grid[idx]

    kappa = (
        x / carga_star
    )

    return float(kappa)


# ============================================================
# 13. ESTIMAÇÃO DE KAPPA
# ============================================================

def estimar_kappa_base(
    df_elegivel
):

    """
    Modelo:

        incremental / baseline
        =
        a_i *
        [1 - exp(-kappa * epsilon * z)]

    Existe uma assíntota a_i por subcategoria.
    """

    dados = df_elegivel.copy()

    dados = dados[
        np.isfinite(
            dados["z"]
        )
        &
        np.isfinite(
            dados["elasticidade"]
        )
        &
        np.isfinite(
            dados["baseline_rs"]
        )
        &
        np.isfinite(
            dados["incremental_rs_so"]
        )
    ]

    dados = dados[
        (dados["z"] > 0)
        &
        (dados["elasticidade"] > 0)
        &
        (dados["baseline_rs"] > 0)
    ]

    dados["y"] = dividir_seguro(
        dados["incremental_rs_so"],
        dados["baseline_rs"]
    )

    dados = dados[
        np.isfinite(dados["y"])
    ]

    if len(dados) < 5:
        return None, {}, "amostra_insuficiente"

    subs = sorted(
        dados["subcategoria"]
        .unique()
    )

    idx = {
        s: i
        for i, s in enumerate(subs)
    }

    def modelo(
        X,
        kappa,
        *a
    ):

        z, eps, s = X

        a = np.asarray(
            a,
            dtype=float
        )

        s = np.asarray(
            s,
            dtype=int
        )

        return (
            a[s]
            *
            (
                1
                -
                np.exp(
                    -kappa
                    * eps
                    * z
                )
            )
        )

    X = (
        dados["z"].to_numpy(
            dtype=float
        ),
        dados["elasticidade"].to_numpy(
            dtype=float
        ),
        dados["subcategoria"]
        .map(idx)
        .to_numpy(
            dtype=int
        ),
    )

    y = dados["y"].to_numpy(
        dtype=float
    )

    # Valores iniciais
    p0 = (
        [0.5]
        +
        [0.5] * len(subs)
    )

    # Limites para impedir resultados
    # completamente absurdos.
    limite_inferior = (
        [1e-6]
        +
        [0.0] * len(subs)
    )

    limite_superior = (
        [20.0]
        +
        [20.0] * len(subs)
    )

    try:

        par, _ = curve_fit(
            modelo,
            X,
            y,
            p0=p0,
            bounds=(
                limite_inferior,
                limite_superior
            ),
            maxfev=50000
        )

    except Exception as erro:

        print(
            "\nFalha na estimação livre de kappa:"
        )

        print(erro)

        return (
            None,
            {},
            "falha_estimacao"
        )

    kappa = float(
        par[0]
    )

    assintotas = dict(
        zip(
            subs,
            par[1:]
        )
    )

    # Detecta encostamento nos limites.
    encostado = (
        kappa <= 1.01e-6
        or
        kappa >= 19.99
    )

    if encostado:

        return (
            kappa,
            assintotas,
            "kappa_no_limite"
        )

    return (
        kappa,
        assintotas,
        "estimado"
    )


# ============================================================
# 14. PREPARAÇÃO DOS PARÂMETROS
# ============================================================

def montar_parametros(
    df,
    alfa_subcategoria,
    r_estoque,
    metodo_kappa="calibrado"
):

    dados = df.copy()

    # --------------------------------------------------------
    # Margem
    # --------------------------------------------------------

    dados["m"] = (
        dados["subcategoria"]
        .map(MARGENS)
    )

    # --------------------------------------------------------
    # Elasticidade
    # --------------------------------------------------------

    dados["elasticidade"] = (
        dados["subcategoria"]
        .map(ELASTICIDADES)
    )

    # --------------------------------------------------------
    # Alfa
    # --------------------------------------------------------

    dados = dados.merge(
        alfa_subcategoria,
        on="subcategoria",
        how="left"
    )

    # --------------------------------------------------------
    # Estoque
    # --------------------------------------------------------

    dados = dados.merge(
        r_estoque[
            [
                "subcategoria",
                "data",
                "r_estoque",
                "flag_r_neutro",
            ]
        ],
        on=[
            "subcategoria",
            "data"
        ],
        how="left"
    )

    # --------------------------------------------------------
    # Lambda
    # --------------------------------------------------------

    lam = lambda_por_calibracao(
        R_ESTOQUE_STAR,
        F_ESTOQUE_STAR
    )

    dados["lambda"] = lam

    # Fator de estoque
    dados["f_estoque"] = f_estoque(
        dados["r_estoque"],
        lam
    )

    # --------------------------------------------------------
    # Kappa
    # --------------------------------------------------------

    if metodo_kappa == "fixo":

        kappa = KAPPA_FIXO

        assintotas = {}

        motivo_kappa = (
            "valor_fixo"
        )

    elif metodo_kappa == "estimado":

        elegivel = dados[
            dados["pagamento_so"] > 0
        ].copy()

        (
            kappa_estimado,
            assintotas,
            motivo_kappa
        ) = estimar_kappa_base(
            elegivel
        )

        if kappa_estimado is None:

            kappa = estimar_kappa_calibrado(
                CARGA_PROMOCIONAL_STAR,
                F_SATURACAO_STAR
            )

            motivo_kappa = (
                motivo_kappa
                +
                "_fallback_calibrado"
            )

        else:

            kappa = kappa_estimado

    else:

        # Recomendado
        kappa = estimar_kappa_calibrado(
            CARGA_PROMOCIONAL_STAR,
            F_SATURACAO_STAR
        )

        assintotas = {}

        motivo_kappa = (
            "calibrado"
        )

    dados["kappa"] = kappa

    # --------------------------------------------------------
    # x e saturação
    # --------------------------------------------------------

    dados["x_saturacao"] = (
        dados["kappa"]
        *
        dados["elasticidade"]
        *
        dados["z"].fillna(0)
    )

    dados["f_saturacao"] = f_saturacao(
        dados["x_saturacao"]
    )

    # --------------------------------------------------------
    # ROI marginal
    # --------------------------------------------------------

    dados["eta"] = ETA_PADRAO

    dados["mroi"] = (
        dados["m"]
        *
        dados["alfa"]
        *
        dados["roi_so"]
        *
        dados["f_estoque"]
        *
        dados["f_saturacao"]
        -
        1
        -
        dados["eta"]
    )

    # --------------------------------------------------------
    # ROI de break-even
    # --------------------------------------------------------

    denominador = (
        dados["m"]
        *
        dados["alfa"]
        *
        dados["f_estoque"]
        *
        dados["f_saturacao"]
    )

    dados["roi_breakeven"] = dividir_seguro(
        1 + dados["eta"],
        denominador
    )

    # --------------------------------------------------------
    # Status econômico
    # --------------------------------------------------------

    dados["status_mroi"] = np.select(
        [
            dados["mroi"] > 0.20,
            dados["mroi"] > 0,
            dados["mroi"] <= 0,
        ],
        [
            "Excelente",
            "Positivo",
            "Negativo",
        ],
        default="Sem dados"
    )

    dados["status_mroi"] = (
        dados["status_mroi"]
        .where(
            dados["pagamento_so"] > 0,
            "Sem promoção"
        )
    )

    # --------------------------------------------------------
    # Dados da configuração
    # --------------------------------------------------------

    controle = {
        "lambda": lam,
        "kappa": kappa,
        "motivo_kappa": motivo_kappa,
        "assintotas": assintotas,
    }

    return dados, controle


