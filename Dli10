import pandas as pd
import numpy as np
from scipy.optimize import minimize

# ============ 1. Carrega base e elasticidades ============
df = pd.read_excel(
    r"C:\Users\silva.d.6\OneDrive - Procter and Gamble\Desktop\limitecredito\araujoestimado.xlsx",
    sheet_name=0
).rename(columns={
    "Sum of investimento": "investimento",
    "Sum of Qtd Vendida": "qtd_vendida",
})
elast = pd.read_excel(
    r"C:\Users\silva.d.6\OneDrive - Procter and Gamble\Desktop\limitecredito\elasticidades1.xlsx"
)

df = df[df["chave"].notna()].copy()
df["ean"] = (df["chave"].astype(str).str.replace(r"\.0$", "", regex=True)
             .str.strip().str[:13])
elast["ean"] = (elast["ean"].astype(str).str.replace(r"\.0$", "", regex=True)
                .str.strip())

df["sazonal"] = (df["dli"].astype(str).str.strip().str.lower() == "y").astype(int)
for col in ["volume", "sellout", "investimento", "ano", "mes"]:
    df[col] = pd.to_numeric(df[col], errors="coerce")
df = df[(df["volume"] > 0) & (df["sellout"] > 0)].copy()
df["preco"] = df["sellout"] / df["volume"]

# ============ 2. Trata elasticidades faltantes (rever) ============
elast["elasticidade"] = pd.to_numeric(elast["elasticidade"], errors="coerce")
elast_ok = elast[elast["confiavel"] == "sim"]
elast_mediana = elast_ok["elasticidade"].median()
elast["elast_final"] = elast["elasticidade"].fillna(elast_mediana)

# ============ 3. Monta Tabela 2 (cenario sazonal) ============
saz = df[df["sazonal"] == 1]
nao_saz = df[df["sazonal"] == 0].copy()

# ordena por tempo para pegar os ultimos meses normais por EAN
nao_saz = nao_saz.sort_values(["ean", "ano", "mes"])

# so meses normais COM investimento (>0); recua no tempo ate juntar 3 por EAN
nao_saz_cominv = nao_saz[nao_saz["investimento"] > 0]
ultimos3 = nao_saz_cominv.groupby("ean").tail(3)

# preco_ref: media dos precos desses ultimos 3 meses normais com investimento
preco_ref = (ultimos3.groupby("ean")["preco"].mean()
             .rename("preco_ref").reset_index())

# investimento_medio: media do investimento desses mesmos 3 meses
inv_medio = (ultimos3.groupby("ean")["investimento"].mean()
             .rename("investimento_medio").reset_index())

# baseline_volume: volume medio fora de promocao, por EAN (todos os meses normais)
base = nao_saz.groupby("ean")["volume"].mean().rename("baseline_volume").reset_index()
saz_vol = saz.groupby("ean")["volume"].mean().rename("baseline_saz").reset_index()

tab2 = (preco_ref.merge(inv_medio, on="ean", how="left")
                 .merge(base, on="ean", how="left")
                 .merge(saz_vol, on="ean", how="left")
                 .merge(elast[["ean", "elast_final"]], on="ean", how="left"))
tab2["baseline_volume"] = tab2["baseline_volume"].fillna(tab2["baseline_saz"])
tab2["elast_final"] = tab2["elast_final"].fillna(elast_mediana)
tab2["investimento_medio"] = tab2["investimento_medio"].fillna(0)

# fator sazonal por EAN
fs = (saz.groupby("ean")["volume"].mean() /
      nao_saz.groupby("ean")["volume"].mean()).rename("fator_sazonal").reset_index()
tab2 = tab2.merge(fs, on="ean", how="left")
tab2["fator_sazonal"] = tab2["fator_sazonal"].fillna(1.0)

tab2 = tab2.dropna(subset=["preco_ref", "baseline_volume"]).reset_index(drop=True)

# ============ 4. Orcamento = investimento TOTAL maximo em periodo dli=y ============
inv_por_periodo = saz.groupby(["ano", "mes"])["investimento"].sum()
orcamento = inv_por_periodo.max()
PISO_FRAC = 0.70

# ============ 5. Otimizacao: investimento paga o desconto; ROI sobre incremental ============
n = len(tab2)
preco_ref_arr = tab2["preco_ref"].values
elast_arr = tab2["elast_final"].values
baseline = tab2["baseline_volume"].values
fator_saz = tab2["fator_sazonal"].values
inv_medio_arr = tab2["investimento_medio"].values

def volume_total(precos):
    return baseline * (precos / preco_ref_arr) ** elast_arr * fator_saz

def volume_incremental(precos):
    return volume_total(precos) - baseline

# investimento TOTAL da acao = desconto x volume
def investimento_saz(precos):
    desconto_unit = np.maximum(preco_ref_arr - precos, 0)
    return desconto_unit * volume_total(precos)

# investimento INCREMENTAL = total da acao - media normal (limitado a >=0)
def investimento_incremental(precos):
    return np.maximum(investimento_saz(precos) - inv_medio_arr, 0)

# OBJETIVO: ROI de volume = volume incremental / investimento INCREMENTAL
def objetivo(x):
    inv_inc = np.sum(investimento_incremental(x))
    return -np.sum(volume_incremental(x)) / max(inv_inc, 1e-6)

# ROI sellout = sellout incremental / investimento INCREMENTAL >= 1
def roi_sellout(x):
    sellout_inc = np.sum(x * volume_incremental(x))
    inv_inc = np.sum(investimento_incremental(x))
    return sellout_inc / max(inv_inc, 1e-6) - 1.0

# teto e piso sobre o investimento TOTAL da acao
def teto_orcamento(x):
    return orcamento - np.sum(investimento_saz(x))

def piso_orcamento(x):
    return np.sum(investimento_saz(x)) - PISO_FRAC * orcamento

restricoes = [
    {"type": "ineq", "fun": roi_sellout},
    {"type": "ineq", "fun": teto_orcamento},
    {"type": "ineq", "fun": piso_orcamento},
]

bounds = [(preco_ref_arr[i] * 0.80, preco_ref_arr[i] * 1.20) for i in range(n)]
x0 = preco_ref_arr * 0.90

res = minimize(objetivo, x0, method="SLSQP", bounds=bounds,
               constraints=restricoes, options={"maxiter": 1000, "ftol": 1e-9})

# ============ 6. Resultado ============
precos_ot = res.x
tab2["preco_praticado_3m"] = preco_ref_arr          # preco dos ultimos 3 meses normais com investimento
tab2["preco_com_investimento"] = precos_ot          # preco apos o desconto pago pelo investimento
tab2["desconto_reais_unit"] = preco_ref_arr - precos_ot     # queda de preco por unidade (R$)
tab2["desconto_%"] = (preco_ref_arr - precos_ot) / preco_ref_arr * 100
tab2["investimento_sazonalidade"] = investimento_saz(precos_ot)
tab2["investimento_incremental"] = investimento_incremental(precos_ot)
tab2["volume_incremental"] = volume_incremental(precos_ot)
tab2["sellout_incremental"] = precos_ot * volume_incremental(precos_ot)

inv_inc_total = tab2["investimento_incremental"].sum()
inv_saz_total = tab2["investimento_sazonalidade"].sum()
roi_vol = tab2["volume_incremental"].sum() / inv_inc_total
roi_sell = tab2["sellout_incremental"].sum() / inv_inc_total

print(f"Orcamento (teto, invest total): {orcamento:,.2f}")
print(f"Convergiu: {res.success} | {res.message}")
print(f"Invest total da acao: {inv_saz_total:,.2f} ({inv_saz_total/orcamento:.0%} do teto)")
print(f"Invest incremental: {inv_inc_total:,.2f}")
print(f"ROI volume: {roi_vol:.4f} | ROI sellout: {roi_sell:.3f}")

saida = r"C:\Users\silva.d.6\OneDrive - Procter and Gamble\Desktop\limitecredito\resultado_otimizacao.xlsx"
tab2.to_excel(saida, index=False)
print("Salvo em:", saida)
print(tab2[["ean", "preco_praticado_3m", "preco_com_investimento", "desconto_reais_unit",
            "desconto_%", "investimento_medio", "investimento_sazonalidade",
            "investimento_incremental", "volume_incremental", "sellout_incremental"]].head(15))
