    print(f"Linhas validas: {len(df)} | EANs: {df['EAN'].nunique()}")
    incr=incrementalidade(df)
    teto,bruto,ultima=teto_global(df)
    TETO_BRUTO=INVESTIMENTO_TOTAL_MAX
    elast,e_glob=elasticidade_within(df)
    rel=calibrar_t_d(incr)
    precos_ext=carregar_precos_externos(_resolver_preco_base())
    cons=consolidar(incr,rel,precos_ext)
    n_ext=int((cons["origem_preco_base"]=="planilha_max").sum())
    print(f"Preco base: {n_ext} EANs via planilha externa, {len(cons)-n_ext} via fallback +7%")

    # Valor de REFERENCIA por EAN (baseline medio) - o mesmo usado nas outras abas
    base_ref = incr.groupby("EAN").agg(
        sellout_base=("sellout_base","mean"),
        inv_base=("inv_base","mean")).reset_index()

    # Executa agrupamento Historico 2026 com base na nova funcao que já aplica o COL_ORDER
    df_2026 = dados_dli_2026(df, ano_calendario=2026, base_ref=base_ref)

    print(f"Elasticidade global (within): {e_glob:.3f} | Teto BRUTO: R$ {TETO_BRUTO:,.2f}")

    # --- dois cenarios ---
    dfA_a,dfA_c,_,_,_ = alocar_lagrange(cons,TETO_BRUTO,elast,cenario="A")
    dfB_a,dfB_c,_,_,_ = alocar_lagrange(cons,TETO_BRUTO,elast,cenario="B")
    checa_e_reporta(dfA_a,dfA_c,TETO_BRUTO,"A")
    checa_e_reporta(dfB_a,dfB_c,TETO_BRUTO,"B")

    for d in (dfA_a,dfB_a):
        if len(d):
            for c in COL_ORDER:
                if c not in d.columns: d[c]=np.nan
    dfA_a=dfA_a[COL_ORDER] if len(dfA_a) else dfA_a
    dfB_a=dfB_a[COL_ORDER] if len(dfB_a) else dfB_a

    # =========================================================================
    # --- AGRUPAMENTOS E ABAS ADICIONAIS ---
    # =========================================================================

    # Aba: Elasticidades
    df_elast = pd.DataFrame([{"EAN": ean, "elasticidade": val[0], "elast_origem": val[1]} for ean, val in elast.items()])

    def agrupar_cenario(df_base, col_agrupamento):
        if len(df_base) == 0:
            return pd.DataFrame(columns=COL_ORDER)
        linhas = []
        for nome, g in df_base.groupby(col_agrupamento):
            linha = {c: "-" for c in COL_ORDER}
            linha[col_agrupamento] = nome
            linha["EAN"] = f"{g['EAN'].nunique()} EANs"
            linha["MG5"] = f"{g['MG5'].nunique()} MG5s"

            for c in ["investimento_bruto_PROJ", "investimento_bruto_ULTIMA_DLI",
                      "sellout_bruto_PROJ", "sellout_bruto_ULTIMA_DLI",
                      "dInvestimento_PROJ", "dSellout_PROJ"]:
                linha[c] = round(pd.to_numeric(g[c], errors='coerce').sum(), 2)

            # VALOR DE REFERENCIA do grupo = MEDIA dos baselines dos itens (media das medias)
            ref_sell = pd.to_numeric(g["sellout_REFERENCIA"], errors='coerce').mean()
            ref_inv  = pd.to_numeric(g["investimento_REFERENCIA"], errors='coerce').mean()
            linha["sellout_REFERENCIA"] = round(ref_sell, 2) if pd.notna(ref_sell) else "-"
            linha["investimento_REFERENCIA"] = round(ref_inv, 2) if pd.notna(ref_inv) else "-"

            # K_RECOMENDADO e invest_por_unidade_PROJ: MEDIA PONDERADA pelo sellout projetado
            w_sell = pd.to_numeric(g["sellout_bruto_PROJ"], errors='coerce').fillna(0)
            if w_sell.sum() > 0:
                linha["K_RECOMENDADO"] = round(np.average(pd.to_numeric(g["K_RECOMENDADO"], errors='coerce').fillna(0), weights=w_sell), 4)
                linha["invest_por_unidade_PROJ"] = round(np.average(pd.to_numeric(g["invest_por_unidade_PROJ"], errors='coerce').fillna(0), weights=w_sell), 4)
            if linha["investimento_bruto_ULTIMA_DLI"] > 0:
                linha["K_ULTIMA_DLI"] = round(np.average(pd.to_numeric(g["K_ULTIMA_DLI"], errors='coerce').fillna(0), weights=pd.to_numeric(g["investimento_bruto_ULTIMA_DLI"], errors='coerce').fillna(0)), 4)
            if linha["sellout_bruto_PROJ"] > 0:
                linha["elasticidade"] = round(np.average(pd.to_numeric(g["elasticidade"], errors='coerce').fillna(0), weights=pd.to_numeric(g["sellout_bruto_PROJ"], errors='coerce').fillna(0)), 3)
            if linha["dInvestimento_PROJ"] > 0:
                linha["ROI_incremental_PROJ"] = round(linha["dSellout_PROJ"] / linha["dInvestimento_PROJ"], 3)

            linhas.append(linha)
        return pd.DataFrame(linhas)[COL_ORDER]

    dfA_cat = agrupar_cenario(dfA_a, "CATEGORIA")
    dfA_sub = agrupar_cenario(dfA_a, "SUB")

    def agrupar_2026(df_26, col_agrupamento):
        if len(df_26) == 0:
            return pd.DataFrame(columns=COL_ORDER)
        linhas = []
        for nome, g in df_26.groupby(col_agrupamento):
            linha = {c: "-" for c in COL_ORDER}
            linha[col_agrupamento] = nome
            linha["EAN"] = f"{g['EAN'].nunique()} EANs"
            linha["MG5"] = f"{g['MG5'].nunique()} MG5s"

            # Somando os historicos preenchidos na grade do Cenario A
            inv_26 = pd.to_numeric(g["investimento_bruto_ULTIMA_DLI"], errors="coerce").fillna(0).sum()
            sell_26 = pd.to_numeric(g["sellout_bruto_ULTIMA_DLI"], errors="coerce").fillna(0).sum()

            linha["investimento_bruto_ULTIMA_DLI"] = round(inv_26, 2)
            linha["sellout_bruto_ULTIMA_DLI"] = round(sell_26, 2)

            if sell_26 > 0:
                # K_ULTIMA_DLI e invest_por_unidade_ULTIMA_DLI: MEDIA PONDERADA pelo sellout realizado
                w26 = pd.to_numeric(g["sellout_bruto_ULTIMA_DLI"], errors='coerce').fillna(0)
                linha["K_ULTIMA_DLI"] = round(np.average(pd.to_numeric(g["K_ULTIMA_DLI"], errors='coerce').fillna(0), weights=w26), 4)
                linha["invest_por_unidade_ULTIMA_DLI"] = round(np.average(pd.to_numeric(g["invest_por_unidade_ULTIMA_DLI"], errors='coerce').fillna(0), weights=w26), 4)

            # VALOR DE REFERENCIA do grupo = MEDIA dos baselines dos itens (media das medias)
            ref_sell = pd.to_numeric(g["sellout_REFERENCIA"], errors='coerce').mean()
            ref_inv  = pd.to_numeric(g["investimento_REFERENCIA"], errors='coerce').mean()
            linha["sellout_REFERENCIA"] = round(ref_sell, 2) if pd.notna(ref_sell) else "-"
            linha["investimento_REFERENCIA"] = round(ref_inv, 2) if pd.notna(ref_inv) else "-"
            # INCREMENTAL do 2026 = soma dos incrementais por item (dSellout/dInvestimento ja calculados)
            dsell = pd.to_numeric(g["dSellout_PROJ"], errors='coerce').sum()
            dinv  = pd.to_numeric(g["dInvestimento_PROJ"], errors='coerce').sum()
            linha["dSellout_PROJ"] = round(dsell, 2)
            linha["dInvestimento_PROJ"] = round(dinv, 2)
            if dinv > 0:
                linha["ROI_incremental_PROJ"] = round(dsell / dinv, 3)

            linha["ano_ULTIMA_DLI"] = 2026
            linhas.append(linha)

        return pd.DataFrame(linhas)[COL_ORDER]

    df26_cat = agrupar_2026(df_2026, "CATEGORIA")
    df26_sub = agrupar_2026(df_2026, "SUB")

    legenda=pd.DataFrame({"Item":[
        "CENARIO A (estrito)","CENARIO B (grupo junto)",
        "elasticidade","elast_origem",
        "K_RECOMENDADO","K_ULTIMA_DLI","invest_por_unidade_PROJ","invest_por_unidade_ULTIMA_DLI",
        "desc_consumidor_PROJ","carga_tributaria","desc_max_ult_dli","preco_base_reaj_PROJ","origem_preco_base","preco_praticado_PROX_DLI",
        "preco_ULTIMA_DLI","investimento_bruto_PROJ","investimento_bruto_ULTIMA_DLI",
        "sellout_bruto_PROJ","sellout_bruto_ULTIMA_DLI",
        "sellout_REFERENCIA","investimento_REFERENCIA","dInvestimento_PROJ",
        "dSellout_PROJ","ROI_incremental_PROJ","item_puxado_pelo_grupo"],
        "Significado":[
        "MG5 so entra na DLI se TODOS os seus itens tem ROI incremental > 1 no K comum. Senao, grupo inteiro cortado.",
        "MG5 entra inteiro se AO MENOS UM item e viavel; itens fracos (ROI<=1) entram junto para nao quebrar o grupo.",
        "Elasticidade-preco usada na projecao de volume (negativa; quanto maior o modulo, mais sensivel a preco)",
        "ORIGEM da elasticidade: 1-ean (estimada no proprio EAN) | 2-sub | 3-categoria | 4-global (fallback). Quanto maior o numero, menos especifica/confiavel.",
        "RECOMENDADO: taxa K = investimento por unidade / preco base. Derivada do valor acordado por unidade; cai se o preco sobe.",
        "REALIZADO: K praticado na ultima DLI (investimento por unidade / preco base).",
        "RECOMENDADO: investimento por UNIDADE vendida (R$/it) sugerido - este e o valor de fato acordado com o varejo.",
        "REALIZADO: investimento por unidade praticado na ultima DLI (R$/it).",
        "PROJETADO: desconto ao consumidor = max(carga tributaria, desconto max da DLI). Fixo por item.",
        "Carga tributaria total aproximada da CATEGORIA (ICMS+PIS/COFINS+IPI). ESTIMATIVA - validar com fiscal.",
        "Desconto maximo praticado na ultima DLI = 1 - preco_DLI / novo_preco_base.",
        "PROJETADO: preco base da proxima DLI. Vem da planilha externa (coluna max) se o EAN existir la; senao fallback interno.",
        "Origem do preco base: 'planilha_max' (carregado externamente, usado como esta) ou 'fallback_+7%' (maior preco c/ >=10% share do ultimo ano fiscal x1.07)",
        "PROJETADO: preco praticado por item na proxima DLI = preco_base*(1-desconto). Restricao: > preco da ultima DLI.",
        "REALIZADO: preco praticado na ultima DLI (piso: preco nao cai abaixo dele)",
        "PROJETADO: investimento bruto estimado na proxima DLI (K x sellout projetado)",
        "REALIZADO: investimento bruto na ultima DLI",
        "PROJETADO: sellout bruto estimado na proxima DLI",
        "REALIZADO: sellout bruto na ultima DLI",
        "REFERENCIA: sellout baseline (media do periodo normal) usado para o incremental. Em abas agrupadas = media das medias dos itens.",
        "REFERENCIA: investimento baseline (media do periodo normal) usado para o incremental. Em abas agrupadas = media das medias dos itens.",
        "PROJETADO: investimento incremental = investimento bruto projetado - investimento de REFERENCIA",
        "PROJETADO: sellout incremental = sellout bruto projetado - sellout de REFERENCIA (OBJETIVO maximizado)",
        "PROJETADO: dSellout/dInvestimento",
        "TRUE = item com ROI<=1 mantido apenas para nao quebrar o MG5 (so aparece no cenario B)"]})

    comparativo=pd.concat([
        resumo_cenario(dfA_a,dfA_c,TETO_BRUTO,e_glob,"A - estrito (tudo-ou-nada c/ ROI>1)"),
        resumo_cenario(dfB_a,dfB_c,TETO_BRUTO,e_glob,"B - grupo junto (mantem itens fracos)").rename(columns={"Valor":"Valor_B"})
    ],axis=1)
    comparativo=comparativo.loc[:,~comparativo.columns.duplicated()]
    comparativo.columns=["Metrica","Cenario_A","Cenario_B"] if comparativo.shape[1]==3 else comparativo.columns

    with pd.ExcelWriter(SAIDA) as w:
        comparativo.to_excel(w,sheet_name="Comparativo A vs B",index=False)
        dfA_a.to_excel(w,sheet_name="Cenario A - Recomendado",index=False)
        dfA_c.to_excel(w,sheet_name="Cenario A - Cortados",index=False)
        dfB_a.to_excel(w,sheet_name="Cenario B - Recomendado",index=False)
        dfB_c.to_excel(w,sheet_name="Cenario B - Cortados",index=False)

        # Insercao das novas abas
        df_elast.to_excel(w, sheet_name="Elasticidades", index=False)
        dfA_cat.to_excel(w, sheet_name="Recomendado Categoria", index=False)
        dfA_sub.to_excel(w, sheet_name="Recomendado SUB", index=False)

        if len(df_2026):
            df_2026.to_excel(w,sheet_name="DLI_2026 (realizado)",index=False)
            df26_cat.to_excel(w, sheet_name="DLI_2026_Categoria", index=False)
            df26_sub.to_excel(w, sheet_name="DLI_2026_SUB", index=False)

        legenda.to_excel(w,sheet_name="Legenda",index=False)
        cons[["EAN","PRODUTO","SUB","preco_base_ult","preco_base","desc_ref","t_ref","dQ_raw","dQ","n_safras"]].to_excel(w,sheet_name="Diagnostico",index=False)

    print(f"\nArquivo salvo: {SAIDA}  (Abas de 2026 atualizadas para utilizar exatamente as mesmas colunas das abas Recomendadas)")
    try:
        import shutil
