# ------------------------- DLI 2026 (Padronizado para COL_ORDER) -------------------------
def dados_dli_2026(df, ano_calendario=2026, base_ref=None):
    """Dados BRUTOS realizados na DLI do ano indicado. Como é histórico,
    os valores são mapeados para as colunas ULTIMA_DLI da grade COL_ORDER.
    O resto é preenchido com '-'.
    base_ref: dict/DataFrame EAN -> (sellout_base, inv_base) = valor de REFERENCIA
    (mesmo baseline das outras abas). Usado para o incremental do 2026 realizado."""
    d = df[(df["is_dli"]) & (df["ANO"]==ano_calendario)].copy()
    if len(d)==0:
        return pd.DataFrame(columns=COL_ORDER)
    perf = perfil(df)[["EAN","PRODUTO","CATEGORIA","SUB","MG5"]]
    agg = d.groupby("EAN").agg(
        sellout_dli_2026=("sellout","mean"),
        investimento_dli_2026=("Sum of investimento","mean"),
        vol_dli_2026=("Sum of Qtd Vendida","mean"),
        preco_dli_2026=("preco/it","mean")
    ).reset_index()
    agg["t_dli_2026"]=np.where(agg["sellout_dli_2026"]>0,
                               agg["investimento_dli_2026"]/agg["sellout_dli_2026"], np.nan).round(4)
    out = agg.merge(perf, on="EAN", how="left")
    # baseline de referencia por EAN (mesmo das outras abas)
    ref = base_ref if base_ref is not None else pd.DataFrame(columns=["EAN","sellout_base","inv_base"])
    out = out.merge(ref, on="EAN", how="left")

    linhas_2026 = []
    for _, r in out.iterrows():
        linha = {c: "-" for c in COL_ORDER}
        linha["EAN"] = r["EAN"]
        linha["PRODUTO"] = r["PRODUTO"]
        linha["CATEGORIA"] = r["CATEGORIA"]
        linha["SUB"] = r["SUB"]
        linha["MG5"] = r["MG5"]

        # Mapeando os dados historicos de 2026 para os slots "ULTIMA DLI"
        inv_26 = float(r["investimento_dli_2026"]) if not pd.isna(r["investimento_dli_2026"]) else np.nan
        sell_26 = float(r["sellout_dli_2026"]) if not pd.isna(r["sellout_dli_2026"]) else np.nan
        linha["preco_ULTIMA_DLI"] = round(float(r["preco_dli_2026"]), 2) if not pd.isna(r["preco_dli_2026"]) else np.nan
        linha["investimento_bruto_ULTIMA_DLI"] = round(inv_26, 2) if not pd.isna(inv_26) else np.nan
        linha["sellout_bruto_ULTIMA_DLI"] = round(sell_26, 2) if not pd.isna(sell_26) else np.nan
        linha["K_ULTIMA_DLI"] = round(float(r["t_dli_2026"]), 4) if not pd.isna(r["t_dli_2026"]) else np.nan
        # investimento por UNIDADE realizado em 2026 (inv / volume)
        vol_26 = float(r["vol_dli_2026"]) if not pd.isna(r["vol_dli_2026"]) else np.nan
        if not pd.isna(inv_26) and not pd.isna(vol_26) and vol_26>0:
            linha["invest_por_unidade_ULTIMA_DLI"] = round(inv_26/vol_26, 4)
        linha["ano_ULTIMA_DLI"] = ano_calendario

        # VALOR DE REFERENCIA (mesmo baseline das outras abas) e INCREMENTAL do 2026
        ref_sell = float(r["sellout_base"]) if "sellout_base" in r and not pd.isna(r["sellout_base"]) else np.nan
        ref_inv  = float(r["inv_base"]) if "inv_base" in r and not pd.isna(r["inv_base"]) else np.nan
        linha["sellout_REFERENCIA"] = round(ref_sell, 2) if not pd.isna(ref_sell) else np.nan
        linha["investimento_REFERENCIA"] = round(ref_inv, 2) if not pd.isna(ref_inv) else np.nan
        if not pd.isna(sell_26) and not pd.isna(ref_sell):
            linha["dSellout_PROJ"] = round(sell_26 - ref_sell, 2)
        if not pd.isna(inv_26) and not pd.isna(ref_inv):
            linha["dInvestimento_PROJ"] = round(inv_26 - ref_inv, 2)
        if isinstance(linha.get("dInvestimento_PROJ"), (int,float)) and linha["dInvestimento_PROJ"]>0:
            linha["ROI_incremental_PROJ"] = round(linha["dSellout_PROJ"] / linha["dInvestimento_PROJ"], 3)

        linhas_2026.append(linha)

    return pd.DataFrame(linhas_2026)[COL_ORDER]


