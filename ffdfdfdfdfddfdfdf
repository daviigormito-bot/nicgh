def _norm(s):
    """Normaliza texto p/ comparacao: minusculas, sem espacos extras/nao-quebravel."""
    return " ".join(str(s).replace("\xa0", " ").split()).lower()

def _mg5_protegido(mg5):
    """True se o MG5 casa com algum termo de MG5_PROTEGIDOS. Casa por 'contem'
    (tolerante a diferencas de espaco, acento de caixa e trechos parciais): basta
    que o termo protegido esteja contido no nome do MG5, ou vice-versa."""
    if not MG5_PROTEGIDOS:
        return False
    alvo=_norm(mg5)
    for termo in MG5_PROTEGIDOS:
        t=_norm(termo)
        if t and (t in alvo or alvo in t):
            return True
    return False
