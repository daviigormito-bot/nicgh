"""
Analise de Sensibilidade para DLI - Elasticidade estimada por EAN

MODELO:
O investimento e a propria verba de desconto: Inv(d) = d * preco_base * Q(d).
Cada EAN recebe o desconto de MAXIMA EFICIENCIA incremental (dSellout/dInv) e a
carteira e preenchida por essa eficiencia ate o teto.

ELASTICIDADE:
Estimada por EAN sobre todo o historico (com fallback SUB -> categoria -> global;
ver otimizador_dli.estimar_elasticidades). Como toda estimativa tem incerteza, a
sensibilidade nao troca a elasticidade por um valor unico: ela ESCALA todas as
elasticidades estimadas por um multiplicador comum, testando a carteira sob uma
resposta ao desconto mais fraca (0,7x) ou mais forte (1,3x) que a estimada.

Para que serve: medir quanto a recomendacao depende da premissa de resposta ao
desconto. Se a carteira, o investimento e o sell-out incremental variam pouco
entre os cenarios, a recomendacao e robusta e nao depende de acertar a
elasticidade na mosca. Os EANs que mudam de status/desconto entre cenarios sao
os candidatos naturais a teste A/B antes de escalar.
"""

import numpy as np
import pandas as pd

import otimizador_dli as base

# Multiplicadores sobre a elasticidade ESTIMADA de cada EAN
CENARIOS = {
    "Resposta fraca (0,7x)":  0.7,
    "Estimada (1,0x)":        1.0,
    "Resposta forte (1,3x)":  1.3,
}


def _cons_com_elasticidade(df, incr):
    cons = base.consolidar_por_ean(incr)
    elast = base.estimar_elasticidades(df)
    cons["elasticidade"] = cons["EAN"].map(
        lambda e: elast.get(e, (base.ELASTICIDADE_BASE, "4-global"))[0]
    )
    return cons


def rodar_cenarios(df, incr, teto):
    """Reotimiza a carteira escalando as elasticidades estimadas por cada fator."""
    linhas_resumo = []
    detalhe_por_cenario = {}

    for nome, mult in CENARIOS.items():
        cons = _cons_com_elasticidade(df, incr)
        res, usado, piso = base.otimizar(cons, teto, elast_mult=mult)
        ativo = res["Status"].str.startswith("Ativado")
        detalhe_por_cenario[nome] = res

        linhas_resumo.append({
            "Cenario": nome,
            "Mult. Elasticidade": mult,
            "EANs Ativados": int(ativo.sum()),
            "EANs Cortados": int((~ativo).sum()),
            "Desconto Medio (%)": round(res.loc[ativo, "desconto_recomendado"].mean() * 100, 1),
            "Investimento Bruto (R$)": round(res.loc[ativo, "inv_bruto_alocado"].sum(), 0),
            "Sell-Out Incremental (R$)": round(res.loc[ativo, "sellout_incremental"].sum(), 0),
        })

    return pd.DataFrame(linhas_resumo), detalhe_por_cenario


def montar_tabela_ean(detalhe):
    """Compara, por EAN, desconto e sell-out incremental entre os cenarios."""
    nomes = list(CENARIOS.keys())
    base_df = detalhe[nomes[1]][["EAN", "PRODUTO", "CATEGORIA", "SUB", "preco_base"]].copy()
    for nome in nomes:
        d = detalhe[nome][["EAN", "desconto_recomendado", "sellout_incremental", "Status"]]
        d = d.rename(columns={
            "desconto_recomendado": f"desc_{nome}",
            "sellout_incremental": f"so_{nome}",
            "Status": f"status_{nome}",
        })
        base_df = base_df.merge(d, on="EAN", how="left")

    tab = pd.DataFrame({
        "EAN": base_df["EAN"],
        "Produto": base_df["PRODUTO"],
        "Categoria": base_df["CATEGORIA"],
        "Subcategoria": base_df["SUB"],
        "Desc Fraca (%)": (base_df[f"desc_{nomes[0]}"] * 100).round(1),
        "Desc Estimada (%)": (base_df[f"desc_{nomes[1]}"] * 100).round(1),
        "Desc Forte (%)": (base_df[f"desc_{nomes[2]}"] * 100).round(1),
        "SO Inc Fraca (R$)": base_df[f"so_{nomes[0]}"].round(0),
        "SO Inc Estimada (R$)": base_df[f"so_{nomes[1]}"].round(0),
        "SO Inc Forte (R$)": base_df[f"so_{nomes[2]}"].round(0),
        "Status Estimada": base_df[f"status_{nomes[1]}"],
    })
    tab["Amplitude SO (R$)"] = (tab["SO Inc Forte (R$)"] - tab["SO Inc Fraca (R$)"]).abs().round(0)
    return tab.sort_values("Amplitude SO (R$)", ascending=False)


def main():
    import os
    arquivo = base.ARQUIVO if base.ARQUIVO else base._resolver_arquivo(perguntar=True)
    df = base.carregar_base(arquivo)
    incr = base.montar_incrementalidade(df)
    teto, _, _ = base.teto_global(df, incr)

    resumo, detalhe = rodar_cenarios(df, incr, teto)
    tab = montar_tabela_ean(detalhe)

    saida_dir = os.path.dirname(os.path.abspath(arquivo)) or "."
    saida = os.path.join(saida_dir, "dli_sensibilidade_cenarios.xlsx")
    tab.to_excel(saida, index=False)
    print(f"\nArquivo gerado:\n  {saida}")

    print("=" * 74)
    print("SENSIBILIDADE - ELASTICIDADE ESTIMADA POR EAN, ESCALADA POR FATOR")
    print("=" * 74)
    print(resumo.to_string(index=False))
    print("-" * 74)
    print("Leitura: cada cenario escala a elasticidade ESTIMADA de cada EAN. Se")
    print("investimento e sell-out incremental variam pouco entre os cenarios, a")
    print("recomendacao e robusta e nao depende de acertar a elasticidade na mosca.")
    print("=" * 74)
    return resumo, tab


if __name__ == "__main__":
    main()
